# Team Kazakhstan — settings for the NAS.
# Copy to .env next to this file (File Station: copy, rename to ".env") and
# fill in the lines marked "FILL IN". The file contains a secret
# (TS_AUTHKEY): keep the folder accessible to administrators only.
# Format: KEY=value, one per line, no spaces around "=", no quotes needed.

# ----------------------------------------------------------------- paths
# Persistent data (database, photos, Tailscale identity). Outside the
# application folder, so that unpacking a new version never touches it.
DATA_DIR=/volume1/docker/team-kz-data
# Backup archives written by scripts/backup.sh.
BACKUP_DIR=/volume1/docker/team-kz-backups
# Optional second copy of every backup on ANOTHER device (USB disk, a share
# of another NAS mounted on this one, ...). Empty = no second copy.
BACKUP_COPY_DIR=

# -------------------------------------------------------- address, HTTPS
# tailscale: own Tailscale machine with HTTPS from Tailscale Serve (default,
#            matches the existing setup; does not touch the NAS's Tailscale).
# proxy:     no Tailscale container; an existing HTTPS reverse proxy (for
#            example the DSM reverse proxy) forwards to HTTP_BIND.
DEPLOY_MODE=tailscale

# Machine name in the tailnet; the address becomes https://<name>.<tailnet>.ts.net
TS_HOSTNAME=team
# FILL IN for the first start: Tailscale admin console → Settings → Keys →
# Generate auth key (one-off; optionally with a tag). Not needed afterwards:
# the identity is stored in DATA_DIR/tailscale. Can be removed after setup.
TS_AUTHKEY=replace-with-your-own-value
# Extra "tailscale up" flags, e.g. --advertise-tags=tag:team-kz
TS_EXTRA_ARGS=
# Public access through Tailscale Funnel. false (default) = only devices in
# the tailnet open the address. true = any device opens it without the
# Tailscale app (e.g. guests); only the sign-in page is public, all data
# needs an account. With true, give every account a long password.
# Switch with a Task Scheduler task: bash .../scripts/funnel.sh on | off
TS_FUNNEL=false

# Public address of the directory (the short link people open).
# auto = taken from Tailscale (tailscale mode), e.g. https://team.tail81e59e.ts.net
# proxy mode: the address of your reverse proxy, e.g. https://team.company.kz
APP_BASE_URL=auto

# Optional port on the NAS. 127.0.0.1:<port> = reachable only from the NAS
# itself (checks, DSM reverse proxy). Empty = no port at all.
# Must not collide with existing services (8080, 8088, 8443 are in use).
HTTP_BIND=127.0.0.1:8095

# proxy mode only: address of the reverse proxy whose X-Forwarded-For is
# trusted. auto = the Docker bridge gateway (DSM reverse proxy on this NAS).
# In tailscale mode this is set to loopback automatically.
TRUST_PROXY=auto
# Extra host names the app answers to (comma separated), e.g. 192.168.1.20:8095
EXTRA_ALLOWED_HOSTS=

# ------------------------------------------------- first administrator
# Optional: setup.sh creates this administrator instead of writing a one-time
# link (ADMIN-LINK.txt). Used only while no administrator exists. The package
# has no default password: you choose it here. Remove the password from this
# file after the first setup and change it in My profile → Change password.
# Example: INITIAL_ADMIN_USERNAME=Miras (sign-in name is not case-sensitive)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------ containers
CONTAINER_PREFIX=teamkz
# User the app runs as inside the container; DATA_DIR/app is owned by it.
APP_UID=1000
APP_GID=1000
# Memory limit of the app container (empty = no limit).
CONTAINER_MEMORY=512m
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.2
# auto = use images/team-kazakhstan-<version>-linux-<arch>.tar if present,
#        otherwise build from source; yes = always build; no = never build.
BUILD_FROM_SOURCE=auto

# ----------------------------------------------------------- application
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48
INVITE_TTL_HOURS=72
LOG_LEVEL=info
TZ=Asia/Almaty

# --------------------------------------------------------------- backups
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7
# Backups created from the admin panel inside DATA_DIR/app/backups.
APP_BACKUP_RETENTION_DAYS=14
